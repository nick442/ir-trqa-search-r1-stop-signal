# =====================================================================
#  Group 23 - settings for the Search-R1 runs on TRQA (Wiki1 + Ecommerce, BM25)
#  Every script sources this file. The TRQA code (github.com/mahta-r/total-recall-qa,
#  commit a97391a) with trqa_cluster.patch applied is expected in ./total-recall-qa.
# =====================================================================

# --- EDIT THESE --------------------------------------------------------
# Slurm account: the course code of NWI-I00041. Check with `sshare -U` on cnlogin22.
ACCOUNT=csedui00041

# Course storage on the csedu network disk: venv, model, corpora, BM25 indexes and results.
COURSE_DIR=/vol/csedu-nobackup/course/I00041_informationretrieval
DATA_ROOT=$COURSE_DIR/users/$USER/trqa

# Optional: corpora / indexes stored elsewhere (empty = the default places under DATA_ROOT).
WIKI_PARTIAL_CORPUS=        # a .jsonl with the 5.9M-passage partial Wikipedia corpus
ECOMMERCE_CORPUS=           # a .jsonl with the e-commerce corpus
WIKI_PARTIAL_BM25_INDEX=    # a Lucene index folder (contains segments_*) over the partial Wiki corpus
ECOMMERCE_BM25_INDEX=       # a Lucene index folder over the e-commerce corpus

# Optional: your Science username to get Slurm emails (leave empty to disable).
MAIL_USER=

# --- EXPERIMENT SETTINGS -----------------------------------------------
SPLIT=test                   # test (reported in the paper) or val
RUN_NAME=phase2              # results go to $DATA_ROOT/results/$RUN_NAME/... (submit.sh refuses RUN_NAME=baseline)
RETRIEVAL_EVAL_KS="3 10 100 1000"
DRA_TOPK=3                   # passages shown to Search-R1 per <search> call (repo default)
MAX_ITER=20                  # max search/think rounds for Search-R1 (repo default)
MODEL_DTYPE=auto             # auto -> fp16 on RTX 2080 Ti (no native bf16), bf16 on Ampere+
SEED=42

# --- MEMORY SEARCH TOOL (search_r1_novel, search_r1_novel_notice) ----
# The search tool remembers what it showed for the current question and pages on to unseen passages.
# The experiment folder encodes both, e.g. search_r1_bm25_novel_passage_d30. The paper uses passage / 30.
NOVELTY_UNIT=passage         # passage | document: what is never shown twice within one question
NOVELTY_DEPTH=30             # D: top BM25 candidates per search step the filter may choose from (10, 30, 100)

# --- MODEL ---------------------------------------------------------------
SEARCH_R1_MODEL=PeterJinGo/SearchR1-nq_hotpotqa_train-qwen2.5-7b-em-ppo-v0.3
