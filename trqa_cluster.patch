+"""[cluster patch] Novelty-aware search tool for Search-R1 (Phase 2, system `search_r1_novel`).
+
+Search-R1's search tool is stateless: a repeated query returns the same passages. This filter gives the
+tool a per-question memory so that it prefers passages (or documents) the agent has not been shown yet.
+Only the choice of the passages shown per search step changes; retrieval (BM25) is untouched.
+
+Per search step, given the BM25 ranking of the step:
+  1. candidates = the top `depth` passages of the ranking;
+  2. unit="passage":  skip candidates that were already shown in an earlier step of this question;
+     unit="document": skip candidates from documents already shown, and keep only the best-ranked
+                      passage per document within this result list;
+  3. show the first `topk` remaining candidates, in BM25 order ("new");
+  4. if fewer than `topk` remain, fill up so the agent still gets `topk` passages: first with the
+     highest-ranked already-shown passages among the candidates ("fill_shown"), then with any other
+     skipped candidate ("fill_other", document mode only: an unseen passage of a seen document, or a
+     second passage of a document in this list), both in BM25 order. Fill-ups may break the
+     one-passage-per-document rule;
+  5. if BM25 returned fewer than `topk` hits, show what exists.
+
+Stop notice (2x2 experiment, systems `search_r1_notice` and `search_r1_novel_notice`): one line the search
+tool adds after the passages when the query has nothing new left (STOP_NOTICE).
+  - without memory (ShownTracker): the tool shows the usual BM25 top `topk`; the notice is given when none
+    of the shown passages is new in this question (also when the search has no hits);
+  - with memory (NoveltyFilter(fill=False)): step 4 is dropped, so the tool shows only the remaining new
+    candidates, possibly none; the notice is given when fewer than `topk` new candidates remain.
+
+This module has no heavy imports on purpose: the unit tests import it without the TRQA environment.
+"""
+
+UNITS = ('passage', 'document')
+STOP_NOTICE = 'No more new results for this query.'
+
+
+def passage_id(doc):
+    """Same lookup as run_evalution._get_passage_id, so ids match the ones written to the result files."""
+    for key in ('id', 'doc_id', 'passage_id', 'docid'):
+        val = doc.get(key)
+        if val is not None:
+            return str(val)
+    if 'title' in doc:
+        return str(doc['title']).strip()
+    raise KeyError("Retrieved doc has no id field. Keys: %s" % list(doc.keys()))
+
+
+def document_id(pid):
+    """Document (= entity) of a passage id: everything before the last '-'.
+    Identical to metrics.retrieval_eval_metrics.extract_entity_id (Wiki1 '18859-0054' -> '18859',
+    Ecommerce 'alcohol-23-0000' -> 'alcohol-23'); kept here so the module stays import-free."""
+    parts = pid.rsplit('-', 1)
+    return parts[0] if len(parts) > 1 else pid
+
+
+class NoveltyFilter:
+    def __init__(self, unit, depth, topk=3, doc_of=document_id, fill=True):
+        if unit not in UNITS:
+            raise ValueError(f"novelty unit must be one of {UNITS}, got {unit!r}")
+        if depth < topk:
+            raise ValueError(f"novelty depth ({depth}) must be >= the number of passages shown per step ({topk})")
+        self.unit = unit
+        self.depth = int(depth)
+        self.topk = int(topk)
+        self.doc_of = doc_of
+        self.fill = bool(fill)  # False: never fill up with already-shown passages (memory + notice)
+        self.reset()
+
+    def reset(self):
+        """Forget everything; call at the start of every question."""
+        self.shown_passages = set()
+        self.shown_documents = set()
+
+    def select(self, ranked_ids):
+        """ranked_ids: passage ids of the step's BM25 ranking, best first (at least the top `depth`).
+
+        Returns (order, info). `order` is a permutation of range(min(depth, len(ranked_ids))): the shown
+        passages first, then the remaining candidates in BM25 order. Passages below `depth` keep their
+        place. `info` is the step log. The shown passages are remembered for the next steps."""
+        n_cand = min(self.depth, len(ranked_ids))
+        cand_ids = [str(pid) for pid in ranked_ids[:n_cand]]
+
+        new, fill_shown, fill_other = [], [], []
+        docs_in_list = set()
+        for i, pid in enumerate(cand_ids):
+            if self.unit == 'passage':
+                (fill_shown if pid in self.shown_passages else new).append(i)
+                continue
+            doc = self.doc_of(pid)
+            if doc not in self.shown_documents and doc not in docs_in_list:
+                docs_in_list.add(doc)
+                new.append(i)
+            elif pid in self.shown_passages:
+                fill_shown.append(i)
+            else:
+                fill_other.append(i)
+
+        picked = [(i, 'new') for i in new[:self.topk]]
+        for pool, kind in (((fill_shown, 'fill_shown'), (fill_other, 'fill_other')) if self.fill else ()):
+            for i in pool:
+                if len(picked) >= self.topk:
+                    break
+                picked.append((i, kind))
+
+        shown_idx = [i for i, _ in picked]
+        shown_set = set(shown_idx)
+        order = shown_idx + [i for i in range(n_cand) if i not in shown_set]
+
+        for i in shown_idx:
+            self.shown_passages.add(cand_ids[i])
+            self.shown_documents.add(self.doc_of(cand_ids[i]))
+
+        info = {
+            'unit': self.unit,
+            'depth': self.depth,
+            'n_candidates': n_cand,
+            'n_new_available': len(new),
+            'n_fillups': sum(1 for _, kind in picked if kind != 'new'),
+            'shown': [{'id': cand_ids[i], 'bm25_rank': i + 1, 'kind': kind} for i, kind in picked],
+        }
+        if not self.fill:  # only logged when fill-ups are off, so the logs of search_r1_novel stay as they were
+            info['fill'] = False
+        return order, info
+
+
+class ShownTracker:
+    """Memory without paging, for the baseline + notice variant: the search tool shows what BM25 returns
+    and only keeps track of what it has shown in this question."""
+
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        self.shown_passages = set()
+
+    def observe(self, shown_ids):
+        """Remember the shown passages; returns how many of them had not been shown before."""
+        ids = [str(pid) for pid in shown_ids]
+        n_new = sum(1 for pid in set(ids) if pid not in self.shown_passages)
+        self.shown_passages.update(ids)
+        return n_new
+
+
+def notice_info(n_shown, n_new_shown, given):
+    """Step log of the stop notice (reasoning_path[i].notice)."""
+    return {'given': bool(given), 'n_shown': int(n_shown), 'n_new_shown': int(n_new_shown)}
