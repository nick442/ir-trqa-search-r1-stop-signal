+# ---------------------------------------------------------------------------
+# [cluster patch] Model loading for small GPUs (e.g. csedu RTX 2080 Ti, 11 GB).
+# The original code loaded the model in bfloat16 onto a single GPU. A 7B model
+# needs ~15 GB in 16-bit, so on 11 GB cards we shard it over 2 GPUs with
+# device_map="auto" and use float16 (Turing GPUs have no native bfloat16).
+# ---------------------------------------------------------------------------
+_DTYPES = {'bf16': torch.bfloat16, 'fp16': torch.float16, 'fp32': torch.float32}
+
+def _resolve_dtype(name):
+    if name in _DTYPES:
+        return _DTYPES[name]
+    # 'auto': bf16 on Ampere+ (what the authors used), fp16 on older GPUs
+    if torch.cuda.is_available():
+        try:
+            native_bf16 = torch.cuda.is_bf16_supported(including_emulation=False)
+        except TypeError:
+            native_bf16 = torch.cuda.get_device_capability()[0] >= 8
+        return torch.bfloat16 if native_bf16 else torch.float16
+    return torch.float32
+
+def _even_device_map(model_name_or_path, n_gpus):
+    """Split the decoder layers evenly over n_gpus (accelerate's "auto" overfills GPU 0,
+    leaving no room for the growing Search-R1 context on 11 GB cards).
+    Embeddings go to the first GPU, final norm + lm_head to the last one."""
+    config = transformers.AutoConfig.from_pretrained(model_name_or_path)
+    n_layers = config.num_hidden_layers
+    per_gpu = -(-n_layers // n_gpus)  # ceil
+    last = n_gpus - 1
+    device_map = {'model.embed_tokens': 0, 'model.rotary_emb': 0, 'model.norm': last,
+                  'lm_head': 0 if getattr(config, 'tie_word_embeddings', False) else last}
+    for i in range(n_layers):
+        device_map[f'model.layers.{i}'] = min(i // per_gpu, last)
+    return device_map
+
+
+def _avoid_sdpa_math_fallback():
+    """On pre-Ampere GPUs (e.g. RTX 2080 Ti) PyTorch has no Flash kernel, and its memory-efficient
+    kernel doesn't support `enable_gqa=True`, which transformers passes for GQA models such as Qwen2.5.
+    SDPA then silently falls back to the math kernel, which materialises the full fp32 attention matrix
+    (memory grows with prompt_length^2 and OOMs at ~4k tokens on 11 GB cards). Expanding the K/V heads
+    ourselves (repeat_kv) gives identical attention and lets the memory-efficient kernel run."""
+    if not torch.cuda.is_available():
+        return False
+    if min(torch.cuda.get_device_capability(i)[0] for i in range(torch.cuda.device_count())) >= 8:
+        return False
+    import transformers.integrations.sdpa_attention as _sdpa
+    _sdpa.use_gqa_in_sdpa = lambda *a, **k: False
+    return True
+
+
+def load_backbone(model_name_or_path, device, args):
+    if _avoid_sdpa_math_fallback():
+        print("[load_backbone] pre-Ampere GPU: disabled SDPA enable_gqa (repeat_kv instead) so the "
+              "memory-efficient attention kernel is used", flush=True)
+    dtype = _resolve_dtype(getattr(args, 'model_dtype', 'auto'))
+    device_map = getattr(args, 'device_map', 'none')
+    quantization = getattr(args, 'quantization', 'none')
+    kwargs = {'dtype': dtype}
